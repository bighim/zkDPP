    function _bricks(bytes32 x1, bytes32 x2, bytes32 x3) internal pure returns ( bytes32 new_x1, bytes32 new_x2, bytes32 new_x3) {

        assembly {
        // bn256 modulus
            let r := 21888242871839275222246405745257275088548364400416034343698204186575808495617

        // x1^2
            let x1_sq := mulmod(x1, x1, r)
        // x2^2
            let x2_sq := mulmod(x2, x2, r)

        // x1, x1^5
            new_x1 := mulmod(mulmod(x1_sq, x1_sq, r), x1, r)

        // x2, a1 = 1 b1 = 2, x2 * (x1^2 + 1 * x1 + 2)
            new_x2 := addmod(x1_sq, addmod(x1, 2, r), r)
            new_x2 := mulmod(x2, new_x2, r)

        // x3, a2 = 3 b2 = 4, x2 * (x1^2 + 3 * x1 + 4)
            new_x3 := addmod(x2_sq, addmod(mulmod(2, x2, r), 4, r), r)
            new_x3 := mulmod(x3, new_x3, r)
        }
    }


