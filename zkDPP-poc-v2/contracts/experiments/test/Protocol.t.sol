pragma solidity ^0.8.30;
import {ExperimentalAuditLedger as L} from "../shared/experiments/ExperimentalAuditLedger.sol";
interface Vm {function readFile(string calldata)external view returns(string memory);function parseJsonBytes(string calldata,string calldata)external pure returns(bytes memory);function parseJsonStringArray(string calldata,string calldata)external pure returns(string[] memory);function parseJsonString(string calldata,string calldata)external pure returns(string memory);function parseJsonBytes32(string calldata,string calldata)external pure returns(bytes32);function parseUint(string calldata)external pure returns(uint256);function toString(uint256)external pure returns(string memory);function getCode(string calldata)external view returns(bytes memory);function roll(uint256)external;function prank(address)external;}
contract ProtocolTest {
 Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
 L ledger;string fixture;
 function deploy(string memory artifact,bytes memory args)internal returns(address addr){bytes memory code=bytes.concat(vm.getCode(artifact),args);assembly{addr:=create(0,add(code,32),mload(code))}require(addr!=address(0),"deployment");require(addr.code.length<=24576,"EIP170");}
 function setUp()public{
  fixture=vm.readFile("test/fixtures/lifecycle.json");address[7] memory fixedV;uint[7] memory indices=[uint(13),14,15,16,17,18,20];for(uint i;i<7;i++)fixedV[i]=deploy(string.concat("Imports.sol:V",vm.toString(indices[i])),"");
  address hasher=deploy("Poseidon2BLS12381.sol:Poseidon2BLS12381","");ledger=L(deploy("ExperimentalAuditLedger.sol:ExperimentalAuditLedger",abi.encode(fixedV,hasher,address(this))));ledger.setEntryIssuer(address(this),true);ledger.registerPolicyAuthority(address(this));
  for(uint i=1;i<=101;i++)ledger.reservePolicy(i==2?8:6);
  for(uint i;i<2;i++){string memory prefix=string.concat(".policies[",vm.toString(i),"]");uint ref=vm.parseUint(vm.parseJsonString(fixture,string.concat(prefix,".ref")));bytes32 hash=vm.parseJsonBytes32(fixture,string.concat(prefix,".hash"));address verifier=deploy(i==0?"Imports.sol:V19":"Imports.sol:V21","");ledger.registerPolicy(ref,i==0?2:1,1,hash,verifier);}
 }
 function read(uint i)internal view returns(bytes memory proof,uint[] memory p,L.AuditCipher memory cipher){string memory key=string.concat(".frames[",vm.toString(i),"]");proof=vm.parseJsonBytes(fixture,string.concat(key,".proof"));string[] memory ss=vm.parseJsonStringArray(fixture,string.concat(key,".public"));p=new uint[](ss.length);for(uint j;j<ss.length;j++)p[j]=vm.parseUint(ss[j]);uint k=kind(i);uint b=k==0?1:k==1?5:k==2?3:k==7?2:k==6?6:4;uint parents=k==0?0:k==4||k==6?2:1;uint future=k==7||k==8?0:k==1||k==5?2:1;cipher.r1X=p[b];cipher.r1Y=p[b+1];cipher.encryptedParents=new uint[](parents);cipher.encryptedOutputNfs=new uint[](future);for(uint j;j<parents;j++)cipher.encryptedParents[j]=p[b+2+j];for(uint j;j<future;j++)cipher.encryptedOutputNfs[j]=p[b+2+parents+j];}
 function kind(uint i)internal pure returns(uint){uint[14] memory ks=[uint(0),0,1,3,1,2,1,2,4,5,6,5,8,7];return ks[i];}
 function payload(uint i)internal view returns(bytes memory data){(bytes memory proof,uint[] memory p,L.AuditCipher memory a)=read(i);uint k=kind(i);if(k==0)return abi.encodeCall(L.entry,(proof,p[0],a));if(k==1)return abi.encodeCall(L.transfer,(proof,p[0],p[1],p[2],p[3],p[4],a));if(k==2)return abi.encodeCall(L.proceed,(proof,p[0],p[1],p[2],a));if(k==3)return abi.encodeCall(L.recall,(proof,p[0],p[1],p[2],p[3],a));if(k==4)return abi.encodeCall(L.merge,(proof,p[0],p[1],p[2],p[3],a));if(k==5)return abi.encodeCall(L.split,(proof,p[0],p[1],p[2],p[3],a));if(k==7)return abi.encodeCall(L.exit,(proof,p[0],p[1],a));if(k==8)return abi.encodeCall(L.issue,(proof,p[0],p[1],p[2],p[3],a));uint[] memory ins=new uint[](2);ins[0]=p[3];ins[1]=p[4];uint[] memory outs=new uint[](1);outs[0]=p[5];return abi.encodeCall(L.process,(proof,p[0],p[1],p[2],ins,outs,a));}
 function execute(uint i)internal{if(kind(i)==6){(,uint[] memory p,)=read(i);ledger.setPolicyGrant(p[0],p[1],true);} (bool ok,)=address(ledger).call(payload(i));require(ok,"real Event rejected");}
 function testRealLifecycleAndDoubleSpend()public{for(uint i;i<14;i++)execute(i);require(ledger.nextAuditRecordId()==15,"record count");(,uint[] memory p,)=read(12);require(ledger.claimRegistered(p[3]),"Claim");(bool ok,)=address(ledger).call(payload(12));require(!ok&&ledger.nextAuditRecordId()==15,"double Issue");}
 function testTamperedCipherIsAtomic()public{bytes memory data=payload(0);data[data.length-1]=bytes1(uint8(data[data.length-1])^1);(bool ok,)=address(ledger).call(data);require(!ok&&ledger.nextAuditRecordId()==1&&ledger.noteLeafCount()==0,"partial change");}
 function testFrozenNoteAndTransferDeadline()public{execute(0);execute(1);(,uint[] memory p,)=read(2);ledger.setStatus(1,p[1],1);(bool ok,)=address(ledger).call(payload(2));require(!ok&&ledger.nextAuditRecordId()==3,"Frozen");ledger.setStatus(1,p[1],0);vm.roll(p[4]);(ok,)=address(ledger).call(payload(2));require(!ok,"Transfer at D");vm.roll(p[4]-1);execute(2);}
 function testVoucherFreezeAndRecallDeadline()public{for(uint i;i<3;i++)execute(i);(bytes memory proof,uint[] memory p,L.AuditCipher memory a)=read(3);ledger.setStatus(2,p[1],1);(bool ok,)=address(ledger).call(payload(3));require(!ok,"Frozen Recall");(ok,)=address(ledger).call(abi.encodeCall(L.proceed,(proof,p[0],p[1],p[2],a)));require(!ok,"Frozen Proceed");ledger.setStatus(2,p[1],0);vm.roll(p[3]+1);(ok,)=address(ledger).call(payload(3));require(!ok,"late Recall");vm.roll(p[3]);execute(3);require(ledger.voucherSpentIn(p[1])!=0,"Recall at D");}
 function testProcessGrantAndWrongArity()public{for(uint i;i<10;i++)execute(i);(bool ok,)=address(ledger).call(payload(10));require(!ok,"missing Grant");(bytes memory proof,uint[] memory p,L.AuditCipher memory a)=read(10);ledger.setPolicyGrant(p[0],p[1],true);uint[] memory ins=new uint[](3);ins[0]=p[3];ins[1]=p[4];uint[] memory outs=new uint[](1);outs[0]=p[5];(ok,)=address(ledger).call(abi.encodeCall(L.process,(proof,p[0],p[1],p[2],ins,outs,a)));require(!ok&&ledger.nextAuditRecordId()==11,"arity atomicity");execute(10);}
 function testStatusAuthorityAndRevocation()public{execute(0);(,uint[] memory p,)=read(2);vm.prank(address(123));(bool ok,)=address(ledger).call(abi.encodeCall(L.setStatus,(1,p[1],1)));require(!ok,"authority");ledger.setStatus(1,p[1],1);ledger.setStatus(1,p[1],2);(ok,)=address(ledger).call(abi.encodeCall(L.setStatus,(1,p[1],0)));require(!ok,"revoked terminal");}
}
